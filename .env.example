# ===== 模型（智谱 BigModel）=====
# 控制台：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your-zhipu-api-key-here

# 可选：覆盖默认配置
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4.5-air

# ===== 企业微信智能机器人（长连接 API 模式）=====
# 企业微信管理后台 → 智能专区 → 智能机器人 → 创建 → API 模式 → 使用长连接
WECOM_BOT_ID=your-bot-id-here
WECOM_BOT_SECRET=your-bot-secret-here

# ===== 聊天通道选择 =====
# wechat=微信 ClawBot/iLink（扫码登录，无需公网 IP）；wecom=企业微信
CHANNEL=wechat
# 微信通道本地状态（含 bot_token、游标、context_token，请勿提交）
WECHAT_STATE_FILE=state/.wechat_state.json
# 微信二维码本地页面（自动用 Chrome 打开）
WECHAT_QR_FILE=state/.wechat_qr.html
# 微信媒体下载目录
WECHAT_MEDIA_DIR=state/media
# 可选：覆盖 iLink 默认地址
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
